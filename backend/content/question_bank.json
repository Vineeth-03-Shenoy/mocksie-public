  "starter_code": {
   "python": "import sys\n\n\ndef longest_run(nums):\n    # Return an int.\n    pass\n\n\ndef main():\n    k = int(sys.stdin.readline())\n    nums = list(map(int, sys.stdin.readline().split()))\n    result = longest_run(nums)\n    print(result)\n\n\nmain()\n",
