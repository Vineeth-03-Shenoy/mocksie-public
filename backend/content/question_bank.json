   "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nint longest_run(const int *nums, int k) {\n    /* Return the int. */\n    return 0;\n}\n\n/* ---- input/output plumbing: you do not need to change anything below ---- */\nstatic char *read_line(void) {\n    size_t cap = 256, len = 0;\n    char *buf = malloc(cap);\n    int ch;\n    while ((ch = fgetc(stdin)) != EOF && ch != '\\n') {\n        if (len + 2 > cap) { cap *= 2; buf = realloc(buf, cap); }\n        buf[len++] = (char)ch;\n    }\n    while (len > 0 && buf[len - 1] == '\\r') len--;\n    buf[len] = '\\0';\n    return buf;\n}\n\nstatic int *read_ints(int count) {\n    int *out = malloc(sizeof(int) * (count + 1));\n    char *line = read_line(), *p = line;\n    for (int i = 0; i < count; i++) out[i] = (int)strtol(p, &p, 10);\n    free(line);\n    return out;\n}\n\nint main(void) {\n    int k = atoi(read_line());\n    int *nums = read_ints(k);\n    int result = longest_run(nums, k);\n    printf(\"%d\\n\", result);\n    return 0;\n}\n"
