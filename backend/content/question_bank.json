  "slug": "longest_run",
  "signature": "longest_run(nums)",
  "statement": "A run is a stretch of equal values next to each other. Return the length of the longest run in the list (0 for an empty list).",
  "io": {
   "input": "Line 1: count k. Line 2: k space-separated integers (empty line if k = 0).",
   "output": "Print the integer.",
   "input_kind": "ints",
