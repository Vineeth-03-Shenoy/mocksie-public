DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Models (swap without code changes). Verified to exist on the account via GET /v1/models.
INTERVIEWER_MODEL=gpt-5.4-mini   # live interviewer
FAST_MODEL=gpt-5.4-nano          # resume extraction + live quick grade
JUDGE_MODEL=gpt-5.4              # final scoring

# Send store=false on every request. Free-allowance data sharing is on, so only redacted text may be sent.
OPENAI_STORE=false

# Free daily allowance pools (tokens/day). mini + nano share DAILY_POOL_SMALL.
DAILY_POOL_SMALL=2500000
DAILY_POOL_JUDGE=250000
# When the judge pool is nearly used: queue = hold scoring jobs until tomorrow, pay = keep going (billed).
JUDGE_OVER_BUDGET=queue
JUDGE_QUEUE_THRESHOLD=0.9

JUDGE_URL=http://localhost:2000
DATABASE_URL=sqlite:///./mocksie.db
# Interviewer login: generate with  python -m backend.auth hash  and paste the line it prints
ADMIN_PASSWORD_HASH=
# Session signing key: at least 32 random characters (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
